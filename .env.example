# ============================================================
# RESTAURANT FOOD ORDERING AND MANAGEMENT SYSTEM
# Environment Configuration Template
# ============================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' (for Vite development):
#    cp .env.example .env
# 2. In your Supabase Dashboard: Go to Project Settings -> API
# 3. Copy your Project URL and Publishable/Anon Key.
# 4. Paste them below.
#
# IMPORTANT: NEVER use or expose the 'service_role' key here!
# Only use the 'anon' (public) key for client applications.
# ============================================================

# For Vite development (prefixed with VITE_)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# For static / non-Vite deployment or direct reference
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
